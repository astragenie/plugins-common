{
  "name": "plugins-common",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "bun --filter '*' lint",
    "format:check": "bun --filter '*' format:check",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "test:gepa-core": "bun --filter @astragenie/gepa-core test",
    "test:plugin-kernel": "bun --filter @astragenie/plugin-kernel test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "typescript": "^5.5.0"
  }
}
