{
  "name": "@astragenie/astramem-openclaw",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw plugin for astramem — local-first, encrypted, provenance-tracked memory backed by the astramem-local daemon. Auto-capture after every turn, auto-recall before every turn, periodic agent-profile injection, and /remember /recall /forget commands. No cloud, no subscription.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astragenie/plugins-common.git",
    "directory": "packages/astramem-openclaw"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openclaw.plugin.json": "./openclaw.plugin.json"
  },
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "engines": {
    "node": ">=22.6.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "format:check": "biome format src tests",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "bun test --parallel --timeout 30000 tests/"
  },
  "dependencies": {
    "@astragenie/astramem-client": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
