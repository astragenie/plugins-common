{
  "name": "@astragenie/gepa-core",
  "version": "0.10.1",
  "description": "GEPA reflective prompt evolution toolkit — Pareto-rank prompt candidates, score with pluggable LLM judges, persist trials.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astragenie/plugins-common.git",
    "directory": "packages/gepa-core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./providers/ollama": {
      "types": "./dist/providers/ollama/index.d.ts",
      "default": "./dist/providers/ollama/index.js"
    },
    "./providers/generic-openai": {
      "types": "./dist/providers/generic-openai/index.d.ts",
      "default": "./dist/providers/generic-openai/index.js"
    },
    "./providers/groq": {
      "types": "./dist/providers/groq/index.d.ts",
      "default": "./dist/providers/groq/index.js"
    },
    "./providers/gemini": {
      "types": "./dist/providers/gemini/index.d.ts",
      "default": "./dist/providers/gemini/index.js"
    },
    "./providers/azure-openai": {
      "types": "./dist/providers/azure-openai/index.d.ts",
      "default": "./dist/providers/azure-openai/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=22.6.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "format:check": "biome format src tests",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "bun test --parallel --timeout 30000 tests/",
    "semver:check": "bun run scripts/check-semver.ts",
    "check:no-env": "bun run scripts/check-no-env-reads.ts"
  },
  "dependencies": {
    "@astragenie/plugin-std": "^0.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@azure/openai": "*",
    "@google/generative-ai": "*"
  },
  "peerDependenciesMeta": {
    "@azure/openai": {
      "optional": true
    },
    "@google/generative-ai": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
