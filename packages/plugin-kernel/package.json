{
  "name": "@astragenie/plugin-kernel",
  "version": "0.0.1",
  "private": true,
  "description": "Shared kernel for the Astragenie plugin ecosystem — workflow-state machine, locks, ID registry, artifact IO, typed events. Extracted from crew/runner (Phase 2, P2.1).",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.6.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "format:check": "biome format src tests",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel --timeout 30000 tests/"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.14",
    "typescript": "^5.5.0"
  }
}
